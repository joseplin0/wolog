{
  "name": "wolog",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:main": "pnpm --filter @wolog/main-app dev",
    "dev:timeline": "pnpm --filter @wolog/app-timeline dev",
    "dev:auth": "pnpm --filter @wolog/app-auth dev",
    "dev:server": "pnpm --filter @wolog/server dev",
    "dev:frontend": "pnpm --filter @wolog/main-app --filter @wolog/app-auth --filter @wolog/app-timeline --parallel run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.30"
  }
}